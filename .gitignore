# Gradle & build caches
.gradle/
build/
**/build/
.idea/
*.iml
.DS_Store

# Temporary & intermediate patcher files
tools/patcher-data/
tools/APKEditor*.jar
# Binary APK files (binaries are hosted on GitHub Releases)
*.apk
*.apk.idsig
output/patching-result*.json
!output/.gitkeep

# Local input files (do not commit stock APKs)
input/splits*/
!input/.gitkeep

# Log files
*.log

# Signing keys (never commit keystores or private keys)
*.keystore
*.jks
*.p12
*.pem
