# Pinned inputs for .github/workflows/release.yml. Every download is checked
# against the SHA-256 here; a mismatch fails the release.

# Official Morphe CLI release (https://github.com/MorpheApp/morphe-cli/releases/tag/v1.18.1)
MORPHE_CLI_VERSION=1.18.1
MORPHE_CLI_URL=https://github.com/MorpheApp/morphe-cli/releases/download/v1.18.1/morphe-desktop-1.18.1-all.jar
MORPHE_CLI_SHA256=1b506ab5f03d16a2f65026d5e0e1910d01fc1e2152f21eaeb44ed2f30856597b

# Stock Gboard 18.4.1.985164140-release, arm64-v8a, from the owner's private repo
BASE_APK_REPO=emilis3/pixelboard-base
BASE_APK_RELEASE=base-gboard-18.4.1
BASE_APK_ASSET=gboard-18.4.1-arm64-v8a.apk
BASE_APK_SHA256=797652f9bf89bb0bf2015a270e715e7bf5f89150891fc74f7ad40c163d3dac75

# Owner signing certificate (SHA-256, lowercase hex, no colons)
SIGNING_CERT_SHA256=037c37dc2eaf3ea084be5489d850df3cb01c9d2ca3c7e030553effb11ef4eaa7

# Android build-tools used for zipalign and apksigner
BUILD_TOOLS_VERSION=35.0.0
